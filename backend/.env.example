# Puerto local (Render lo asigna automáticamente en producción)
PORT=4000

# development | production
NODE_ENV=development

# Supabase > Project Settings > API Keys
# SUPABASE_SERVICE_KEY = service_role key (o "secret key"). ¡Es secreta! Nunca en el frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# Contraseña del administrador para entrar al panel (mínimo 12 caracteres en producción)
ADMIN_PASSWORD=cambia-esta-contraseña

# Llave secreta para firmar los tokens de sesión (mínimo 32 caracteres en producción).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla cierra todas las sesiones abiertas.
AUTH_SECRET=pega-aqui-una-cadena-aleatoria-larga

# Dominio(s) del frontend permitidos por CORS, separados por coma y sin "/" final.
# En desarrollo se permite localhost automáticamente.
FRONTEND_URL=https://mi-frontend.onrender.com
